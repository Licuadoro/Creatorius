coverage/lcov-report/

# Distribution / packaging
*.tar.gz
*.whl
*.egg
*.egg-info/

# Local configuration
config/local.*
!config/default.js

# Compiled CSS/JS source maps (generated by bundlers)
*.css.map
*.js.map

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Debug log
debug.log

# Production secrets
secrets/
```